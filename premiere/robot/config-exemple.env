# Modèle de robot/config.env (le vrai fichier n'est jamais versionné).
# Format : CLE=valeur, une par ligne, sans guillemets ni espaces autour du « = ».
# Lu par robot.py et configurer.py. Créé et testé par : bash installer.sh

# Projet Supabase (Supabase > Project Settings > API)
SUPABASE_URL=https://<identifiant-du-projet>.supabase.co
# Clé publique du projet : « publishable » (sb_publishable_...) ou ancienne clé « anon » (JWT eyJ...)
SUPABASE_ANON_KEY=<cle-publique>

# Compte utilisateur de l'app (Supabase Auth, e-mail + mot de passe).
# Le robot se connecte AVEC CE COMPTE (sécurité RLS appliquée) : aucune clé service_role n'est utilisée.
EMAIL=<e-mail-du-compte-de-l-app>
MOT_DE_PASSE=<secret>

# Alertes iPhone via ntfy.sh : nom de canal privé et difficile à deviner (vide = pas d'alerte iPhone)
NTFY_TOPIC=<sujet-ntfy>

# Adresse de l'app, ouverte quand on touche une alerte (facultatif)
APP_URL=https://<nom-du-worker>.<compte>.workers.dev

# Secondes d'attente entre deux clics du robot (nombre, défaut 5)
PAUSE=5
